{
  "datasets": [
    {
      "name": "c4dba24e",
      "displayName": "OHLC Data",
      "queryLines": [
        "WITH dedup AS (\r\n",
        "  SELECT\r\n",
        "    coin_id,\r\n",
        "    CAST(timestamp AS TIMESTAMP) as timestamp,\r\n",
        "    open_price,\r\n",
        "    high_price,\r\n",
        "    low_price,\r\n",
        "    close_price,\r\n",
        "    vs_currency,\r\n",
        "    etl_timestamp,\r\n",
        "    row_number() over (partition by \r\n",
        "      coin_id,\r\n",
        "      CAST(timestamp AS TIMESTAMP)\r\n",
        "      order by etl_timestamp\r\n",
        "    ) AS rn\r\n",
        "  FROM\r\n",
        "    dbx_joshdevph_dev.processed.cg_coin_ohlc_chart\r\n",
        "  WHERE\r\n",
        "    timestamp IS NOT NULL\r\n",
        ")\r\n",
        "\r\n",
        "SELECT *\r\n",
        "FROM dedup \r\n",
        "WHERE rn = 1\r\n",
        "ORDER BY timestamp"
      ]
    },
    {
      "name": "7f72dd7e",
      "displayName": "Historical Market Data",
      "queryLines": [
        "with dedup As (\r\n",
        "  SELECT\r\n",
        "    coin_id,\r\n",
        "    CAST(timestamp AS TIMESTAMP) as timestamp,\r\n",
        "    price,\r\n",
        "    market_cap,\r\n",
        "    total_volume,\r\n",
        "    vs_currency,\r\n",
        "    row_number() over (partition by coin_id, timestamp order by etl_timestamp desc) as rn\r\n",
        "  FROM\r\n",
        "    dbx_joshdevph_dev.processed.cg_coin_historical_chart_data\r\n",
        "  WHERE\r\n",
        "    timestamp IS NOT NULL  \r\n",
        ")\r\n",
        "\r\n",
        "SELECT *\r\n",
        "FROM dedup\r\n",
        "WHERE rn = 1\r\n",
        "ORDER BY\r\n",
        "  timestamp"
      ]
    }
  ],
